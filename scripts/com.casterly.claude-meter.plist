<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.casterly.claude-meter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/casterly/.local/share/claude-meter/venv/bin/claude-meter</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Only load inside a real Aqua GUI session. Without this, launchd can
         start the Qt app before the window server / login session is ready at
         boot; the process then exits immediately (no display to draw to) and
         KeepAlive respawns it in a tight loop — a contributor to the "broken
         after reboot" symptom. Aqua = a logged-in graphical session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <!-- Background ThrottleInterval so a respawn loop can't hammer the CPU. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/claude-meter.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-meter.log</string>
</dict>
</plist>
